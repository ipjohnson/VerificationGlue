<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- VerificationGlue.Tests builds against the MTP 3 previews, which are published only here. -->
    <add key="test-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/test-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- The stable Microsoft.Testing.* versions the samples need are on nuget.org; the MTP 3 previews are on test-tools. -->
      <package pattern="Microsoft.Testing.*" />
    </packageSource>
    <packageSource key="test-tools">
      <package pattern="Microsoft.Testing.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
