<Project>
  <!--
    Packaging rules shared by the four packages.

    A ProjectReference with PackAsAnalyzer="true" names a generator project. Its assembly goes into
    analyzers/dotnet/cs of this package, so the runtime and the generator always ship at one version.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddGeneratorsToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/logo/icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!--
    With VerificationGlueReportTrx=true every test application has the TRX extension, so report-trx
    works across the solution. test/Hardening.Mutations builds with it to name each mutation's failing cases,
    and the build job of ci.yml builds with it for the run report.
    Restore does not import package props, so a test application of xunit or MSTest is found by
    its package reference rather than by IsTestingPlatformApplication. NUnit3TestAdapter 5.2.0 fails to
    start on the Microsoft.Testing.Platform version the extension needs, so NUnit projects go without it.
    TUnit already brings a TRX extension built for its Microsoft.Testing.Platform version. The newer
    extension lifts the platform past the types TUnit's GitHubReporter loads, so TUnit projects keep their own.
  -->
  <ItemGroup Condition="'$(VerificationGlueReportTrx)' == 'true' and '@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Testing.Extensions.TrxReport'))' == '' and '@(PackageReference->WithMetadataValue('Identity', 'NUnit3TestAdapter'))' == '' and '@(PackageReference->WithMetadataValue('Identity', 'TUnit'))' == '' and ('$(IsTestingPlatformApplication)' == 'true' or '@(PackageReference->WithMetadataValue('Identity', 'xunit.v3'))@(PackageReference->WithMetadataValue('Identity', 'MSTest'))' != '')">
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <Target Name="AddGeneratorsToPackage">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('PackAsAnalyzer', 'true'))"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_GeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <!--
    NuGet packs a ProjectReference as a minimum-version dependency. The packages share one version,
    so a package depends on exactly the version of each package it references.
  -->
  <Target Name="UseExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ExactProjectReferenceVersion Include="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ExactProjectReferenceVersion>
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_ExactProjectReferenceVersion)" />
    </ItemGroup>
  </Target>
</Project>
