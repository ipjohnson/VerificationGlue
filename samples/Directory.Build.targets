<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    A sample that sets UseVerificationGlueMocks to true gets what the VerificationGlue.Mocks package
    adds: the runtime, the generator and the two buildTransitive files. The props only set
    properties and items that the build reads later, so they can be imported here, after the
    project file has set the switch.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../src/VerificationGlue.Mocks/buildTransitive/VerificationGlue.Mocks.props" Condition="'$(UseVerificationGlueMocks)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)../src/VerificationGlue.Mocks/buildTransitive/VerificationGlue.Mocks.targets" Condition="'$(UseVerificationGlueMocks)' == 'true'" />
  <ItemGroup Condition="'$(UseVerificationGlueMocks)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/VerificationGlue.Mocks/VerificationGlue.Mocks.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/VerificationGlue.Mocks.Generator/VerificationGlue.Mocks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
