<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Built by eng/pack-and-consume.sh against the packed packages in a local feed.
    It references VerificationGlue.Tests, as a user's test project does, and publishes its tests with Native AOT.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- begin-snippet: publish-tests-with-native-aot -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!-- end-snippet -->

  <!-- begin-snippet: reference-verificationglue-tests -->
  <ItemGroup>
    <PackageReference Include="VerificationGlue.Tests" Version="$(VerificationGlueVersion)" />
  </ItemGroup>
  <!-- end-snippet -->

  <!-- begin-snippet: reference-trx-report -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="3.0.0-preview.26566.9" />
  </ItemGroup>
  <!-- end-snippet -->

  <!-- Rooting the runtimes makes the Native AOT publish analyze all of their code, not only what this sample calls. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="VerificationGlue" />
    <TrimmerRootAssembly Include="VerificationGlue.Mocks" />
    <TrimmerRootAssembly Include="VerificationGlue.Tests" />
  </ItemGroup>

  <Target Name="CheckVerificationGlueVersion" BeforeTargets="_CheckForInvalidConfigurationAndPlatform">
    <Error Condition="'$(VerificationGlueVersion)' == ''" Text="Set VerificationGlueVersion to the version of the packed packages." />
  </Target>

  <!-- The props and generators of all three packages must reach a project that references only VerificationGlue.Tests. -->
  <Target Name="CheckTransitivePackageAssets" BeforeTargets="CoreCompile">
    <Error Condition="!$(InterceptorsNamespaces.Contains('VerificationGlue.Generated'))"
           Text="buildTransitive/VerificationGlue.props was not imported. InterceptorsNamespaces is '$(InterceptorsNamespaces)'." />
    <Error Condition="!$(InterceptorsNamespaces.Contains('VerificationGlue.Mocks.Generated'))"
           Text="buildTransitive/VerificationGlue.Mocks.props was not imported. InterceptorsNamespaces is '$(InterceptorsNamespaces)'." />
    <Error Condition="'@(Analyzer->AnyHaveMetadataValue('Filename', 'VerificationGlue.Generator'))' != 'true'"
           Text="The VerificationGlue generator was not passed to the compiler." />
    <Error Condition="'@(Analyzer->AnyHaveMetadataValue('Filename', 'VerificationGlue.Mocks.Generator'))' != 'true'"
           Text="The VerificationGlue.Mocks generator was not passed to the compiler." />
    <Error Condition="'@(Analyzer->AnyHaveMetadataValue('Filename', 'VerificationGlue.Tests.Generator'))' != 'true'"
           Text="The VerificationGlue.Tests generator was not passed to the compiler." />
    <Error Condition="'$(IsTestingPlatformApplication)' != 'true' Or '$(OutputType)' != 'Exe'"
           Text="build/VerificationGlue.Tests.props was not imported. IsTestingPlatformApplication is '$(IsTestingPlatformApplication)' and OutputType is '$(OutputType)'." />
  </Target>
</Project>
