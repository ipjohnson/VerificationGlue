<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tests in docs/guide/getting-started-aspnetcore.md. dotnet test on the solution runs them on the MTP 3
    preview. The imports and the references to src add what the VerificationGlue.Tests and
    VerificationGlue.Tests.AspNetCore packages add; samples/Directory.Build.props adds the VerificationGlue part.
  -->
  <Import Project="../../src/VerificationGlue.Tests/build/VerificationGlue.Tests.props" />

  <PropertyGroup>
    <UseVerificationGlueMocks>true</UseVerificationGlueMocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue.Tests/VerificationGlue.Tests.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Tests.Generator/VerificationGlue.Tests.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/VerificationGlue.Tests.AspNetCore/VerificationGlue.Tests.AspNetCore.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Tests.AspNetCore.Generator/VerificationGlue.Tests.AspNetCore.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- begin-snippet: reference-the-app -->
  <ItemGroup>
    <ProjectReference Include="../ShopApi/ShopApi.csproj" />
  </ItemGroup>
  <!-- end-snippet -->

  <Import Project="../../src/VerificationGlue.Tests/build/VerificationGlue.Tests.targets" />
</Project>
