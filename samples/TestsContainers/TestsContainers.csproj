<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The tests in docs/guide/containers-and-scopes.md, docs/guide/test-parameters.md and
    docs/guide/extending.md. dotnet test on the solution runs them on the MTP 3 preview. The import,
    the references and UseVerificationGlueMocks add what the VerificationGlue.Tests package adds;
    samples/Directory.Build.props adds the VerificationGlue part.
  -->
  <Import Project="../../src/VerificationGlue.Tests/build/VerificationGlue.Tests.props" />

  <PropertyGroup>
    <UseVerificationGlueMocks>true</UseVerificationGlueMocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue.Tests/VerificationGlue.Tests.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Tests.Generator/VerificationGlue.Tests.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <Import Project="../../src/VerificationGlue.Tests/build/VerificationGlue.Tests.targets" />
</Project>
