<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Glue.Mocks.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated/**" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <ProjectReference Include="../src/Glue.Mocks/Glue.Mocks.csproj" />
    <ProjectReference Include="../src/Glue.Mocks.Generator/Glue.Mocks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
