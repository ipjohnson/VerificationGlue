<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles><CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    <InterceptorsNamespaces Condition="'$(NoInterceptors)' != 'true'">$(InterceptorsNamespaces);Glue.Mocks.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated/**" />
    <Reference Include="Vendor.Contracts"><HintPath>libs/Vendor.Contracts.dll</HintPath></Reference>
    <ProjectReference Include="../src/Glue.Mocks/Glue.Mocks.csproj" />
    <ProjectReference Include="../src/Glue.Mocks.Generator/Glue.Mocks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
