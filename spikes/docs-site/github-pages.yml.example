name: Documentation Pages
on:
  workflow_dispatch:
  push:
    branches: [main]
    paths: ['docs/**', 'spikes/docs-site/**', 'README.md', '.github/workflows/docs-pages.yml']
permissions:
  contents: read
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
          cache-dependency-path: spikes/docs-site/package-lock.json
      - uses: actions/configure-pages@v5
      - run: npm ci
        working-directory: spikes/docs-site
      - run: npm run build
        working-directory: spikes/docs-site
      - uses: actions/upload-pages-artifact@v3
        with:
          path: spikes/docs-site/.vitepress/dist
  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy
        id: deployment
        uses: actions/deploy-pages@v4
