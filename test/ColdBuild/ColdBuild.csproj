<Project Sdk="Microsoft.NET.Sdk">
  <!-- The cold-build benchmark from docs/design/verification-glue.md. Program.cs lists its options. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue/VerificationGlue.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Generator/VerificationGlue.Generator.csproj" ReferenceOutputAssembly="false" OutputItemType="ColdBuildGenerator" />
  </ItemGroup>
  <ItemGroup>
    <None Include="budgets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyColdBuildGenerator" AfterTargets="Build">
    <Copy SourceFiles="@(ColdBuildGenerator)" DestinationFolder="$(OutDir)generator" SkipUnchangedFiles="true" />
  </Target>
</Project>
