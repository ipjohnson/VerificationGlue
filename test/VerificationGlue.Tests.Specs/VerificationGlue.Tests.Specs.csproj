<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs test/VerificationGlue.Tests.Fixture as a process. It does not reference VerificationGlue.Tests,
    which builds against the MTP 3 preview, because these specs run on xunit v3 and MTP 2.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="VerificationGlue.Configuration" Value="$(Configuration)" />
  </ItemGroup>
  <!-- The runtime alone, for OpenDefectSpecs. Without the generator its checks give tier 1 messages. -->
  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue/VerificationGlue.csproj" />
  </ItemGroup>
</Project>
