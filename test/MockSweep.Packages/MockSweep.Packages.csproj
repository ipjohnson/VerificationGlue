<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The packages the mock shape sweep covers: the top 100 on https://www.nuget.org/stats/packages
    on 2026-11-17, each at its latest stable version that day. The four Entity Framework Core
    packages and Microsoft.Net.Http.Headers are at 10.0.15, because their 11.0.0 releases support
    only net11.0 and the sweep runs on the net10.0 SDK in global.json. Building this project restores them
    and writes the compile references to obj/sweep-references.txt, which test/MockSweep reads.
    It is not in the solution, so an ordinary build does not restore 100 packages.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1510;NU1603;NU1605;NU1608;NU1701;NU1903;NU1904</NoWarn>
    <SweepReferencesFile>$(MSBuildProjectDirectory)/obj/sweep-references.txt</SweepReferencesFile>
  </PropertyGroup>

  <!-- Only compile assets matter. The others would run test SDK and analyzer build logic. -->
  <ItemDefinitionGroup>
    <PackageReference>
      <ExcludeAssets>build;buildTransitive;analyzers;contentFiles;native;runtime</ExcludeAssets>
    </PackageReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
