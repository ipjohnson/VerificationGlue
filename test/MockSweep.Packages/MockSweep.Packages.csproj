  </ItemGroup>

  <!--
    One line per package reference, "package <id>", and one per compile reference,
    "reference <package id or framework name> <path>".
  -->
  <Target Name="WriteSweepReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_SweepLine Include="@(PackageReference->'package&#9;%(Identity)')" />
      <_SweepLine Include="@(ReferencePath->'reference&#9;%(NuGetPackageId)%(FrameworkReferenceName)&#9;%(FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(SweepReferencesFile)" Lines="@(_SweepLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
