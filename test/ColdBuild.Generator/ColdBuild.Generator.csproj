<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The generator the cold-build benchmark times. It follows the pipelines in
    docs/design/verification-glue.md so its cost stands in for tier 2 and tier 3 until the product
    generator exists. It is not product code.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PackageCSharpAuthorIncludeRoslyn>true</PackageCSharpAuthorIncludeRoslyn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="CSharpAuthor" PrivateAssets="all" IncludeAssets="build" />
  </ItemGroup>
</Project>
