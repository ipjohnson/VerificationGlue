<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The harness of docs/design/hardening.md, steps 2, 3 and 5. It is not in VerificationGlue.slnx, so the
    build job's `dotnet test` leaves it out. The hardening job in .github/workflows/ci.yml runs it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../src/VerificationGlue.Generator/VerificationGlue.Generator.csproj" />
    <ProjectReference Include="../../src/VerificationGlue/VerificationGlue.csproj" />
    <ProjectReference Include="../Generator.Harness/Generator.Harness.csproj" />
  </ItemGroup>

  <!--
    Step 3 runs mocks the public generator builds, as VerificationGlue.Mocks adds it to a user's
    project: the runtime, the generator and buildTransitive/VerificationGlue.Mocks.props.
  -->
  <Import Project="../../src/VerificationGlue.Mocks/buildTransitive/VerificationGlue.Mocks.props" />
  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue.Mocks/VerificationGlue.Mocks.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Mocks.Generator/VerificationGlue.Mocks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The step 5 interaction cases in Interactions/ need tier 3 rewriting, so the project also runs the
    VerificationGlue generator, as the VerificationGlue package adds it. The step 2 cases compile their
    own sources and do not use it.
  -->
  <Import Project="../../src/VerificationGlue/buildTransitive/VerificationGlue.props" />
  <PropertyGroup>
    <VerificationGlueRewrite>true</VerificationGlueRewrite>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue.Generator/VerificationGlue.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The step 3 shape consumers in ShapeConsumers/ use the hand-written shape files of the generator specs
    through the public generator. The files with a library need it as an assembly, the extern-aliased
    ones under the alias the file names. Pointers.cs needs unsafe code.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../VerificationGlue.Mocks.Generator.Specs/Shapes/Collisions.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Constraints.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/ExternAlias.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/ExternAliasNested.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/InternalsVisibleTo.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Members.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Names.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Nullable.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Obsolete.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Parameters.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/Pointers.cs;../VerificationGlue.Mocks.Generator.Specs/Shapes/RefStruct.cs" LinkBase="ShapeConsumers/Corpus" />
    <ProjectReference Include="../Hardening.Shapes/VendorV1/Hardening.Shapes.VendorV1.csproj" Aliases="V1" />
    <ProjectReference Include="../Hardening.Shapes/VendorV2/Hardening.Shapes.VendorV2.csproj" Aliases="V2" />
    <ProjectReference Include="../Hardening.Shapes/Friend/Hardening.Shapes.Friend.csproj" />
  </ItemGroup>
</Project>
