<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The harness of docs/design/hardening.md, steps 2 and 3. It is not in VerificationGlue.slnx, so the
    build job's `dotnet test` leaves it out. The hardening job in .github/workflows/ci.yml runs it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="../../src/VerificationGlue.Generator/VerificationGlue.Generator.csproj" />
    <ProjectReference Include="../../src/VerificationGlue/VerificationGlue.csproj" />
    <ProjectReference Include="../Generator.Harness/Generator.Harness.csproj" />
  </ItemGroup>

  <!--
    Step 3 runs mocks the public generator builds, as VerificationGlue.Mocks adds it to a user's
    project: the runtime, the generator and buildTransitive/VerificationGlue.Mocks.props.
  -->
  <Import Project="../../src/VerificationGlue.Mocks/buildTransitive/VerificationGlue.Mocks.props" />
  <ItemGroup>
    <ProjectReference Include="../../src/VerificationGlue.Mocks/VerificationGlue.Mocks.csproj" />
    <ProjectReference Include="../../src/VerificationGlue.Mocks.Generator/VerificationGlue.Mocks.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
