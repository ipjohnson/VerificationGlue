<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the run report and the coverage report of the hardening job in .github/workflows/ci.yml from
    the TRX file of each step. docs/design/hardening.md, Run and coverage reports, describes both.
    test/Inventory.Specs holds its specs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
