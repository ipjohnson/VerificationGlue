<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Verify and Check assertions with generated failure messages that work under Native AOT.</Description>
    <PackageTags>testing assertions verify aot source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VerificationGlue.Generator/VerificationGlue.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true" />
    <ProjectReference Include="../VerificationGlue.CodeFixes/VerificationGlue.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true" />
    <None Include="buildTransitive/VerificationGlue.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="llms.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
