<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Starts an ASP.NET Core app on TestServer for each VerificationGlue.Tests test, with the test's mocks in the app.</Description>
    <!-- Microsoft.Testing.Platform comes in through VerificationGlue.Tests. This library is not a test application. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../VerificationGlue.Tests/VerificationGlue.Tests.csproj" PrivateAssets="none" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
