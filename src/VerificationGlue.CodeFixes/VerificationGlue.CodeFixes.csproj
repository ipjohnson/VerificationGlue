<Project Sdk="Microsoft.NET.Sdk">
  <!-- Code fixes reference Workspaces, which the compiler does not load, so they live outside the generator assembly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VerificationGlue.Generator.Specs" />
  </ItemGroup>
</Project>
